#define IDD_WLEVEL 20000
#define IDC_STC6 20001
#define IDC_LEVEL 20005
#define IDC_STC7 20004
#define IDB_LOAD_LEVEL 20006
IDD_WLEVEL DIALOGEX 3,3,169,34
CAPTION "Загрузка любого уровня"
FONT 14,"Arial"
STYLE 0x10C80000
EXSTYLE 0x00000000
BEGIN
  CONTROL "Хотите загрузить определенный уровень?",IDC_STC6,"Static",0x50000000,17,2,137,9,0x00000000
  CONTROL "Уровень:",IDC_STC7,"Static",0x50000000,3,16,30,9,0x00000000
  CONTROL "",IDC_LEVEL,"Edit",0x50012000,41,16,33,11,0x00000200
  CONTROL "Грузим",IDB_LOAD_LEVEL,"Button",0x50010000,80,16,75,11,0x00000000
END
